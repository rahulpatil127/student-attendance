# Copy to .env and fill in real values. Never commit .env with secrets.
DEBUG=True
SECRET_KEY=change-me-generate-a-strong-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=db.sqlite3
TIME_ZONE=UTC
# Session expiry in seconds (default 2 weeks Django default; e.g. 43200 = 12h, 28800 = 8h)
SESSION_COOKIE_AGE=43200
